@accountId = 9
@receiverAccountId = 10

### Weather Forecast
GET {{DigitalBankingAPI_HostAddress}}/weatherforecast/
Accept: application/json

### Authentication Test
GET {{DigitalBankingAPI_HostAddress}}/api/auth/test
Accept: application/json

### Login
POST {{DigitalBankingAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
    "username": "test_user_a",
    "password": "AnotherPassword123!"
}
### Get My Accounts
GET {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}
Authorization: Bearer {{token}}
Accept: application/json
### Deposit
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/deposit
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": 100
}
### Get Transaction History
GET {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/transactions?page=1&pageSize=10
Authorization: Bearer {{token}}
Accept: application/json
### Withdraw
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/withdraw
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": 50
}
### Test Insufficient Balance
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/withdraw
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": 1000
}
### Successful Transfer
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "toAccountId": {{receiverAccountId}},
    "amount": 50
}
### Test Transfer - Insufficient Balance
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "toAccountId": {{receiverAccountId}},
    "amount": 1000
}
### Transfer to Same Account
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "toAccountId": {{accountId}},
    "amount": 50
}
### Transfer with Negative Amount
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "toAccountId": {{receiverAccountId}},
    "amount": -50
}
### Transfer to Nonexistent Account
POST {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "toAccountId": 99999,
    "amount": 50
}
### Access Another User's Account
GET {{DigitalBankingAPI_HostAddress}}/api/accounts/2
Authorization: Bearer {{token}}
Accept: application/json
### Access Account Without Token
GET {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}
Accept: application/json
### Invalid Access Token
GET {{DigitalBankingAPI_HostAddress}}/api/accounts/{{accountId}}
Authorization: Bearer invalid_token
Accept: application/json